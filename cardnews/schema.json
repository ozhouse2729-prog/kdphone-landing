{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IT 카드뉴스 3p",
  "description": "글자 수는 공백 포함, [[ ]] 제외 기준. maxLength는 [[ ]] 4자를 더한 여유값이며 정확한 검사는 studio.html이 한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "cover", "detail", "summary"],
  "properties": {
    "meta": {
      "type": "object", "additionalProperties": false,
      "required": ["product", "status", "date", "sources"],
      "properties": {
        "product": { "type": "string", "minLength": 1, "maxLength": 14 },
        "status": { "enum": ["공식", "루머", "유출"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "url"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 20 },
              "url": { "type": "string", "pattern": "^https?://\\S+$" }
            }
          }
        }
      }
    },
    "cover": {
      "type": "object", "additionalProperties": false,
      "required": ["tag", "kicker", "title", "imageBrief"],
      "properties": {
        "tag": { "enum": ["신제품", "출시확정", "가격", "업데이트", "루머", "유출", "비교", "이슈"] },
        "kicker": { "type": "string", "minLength": 1, "maxLength": 16 },
        "title": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 13 } },
        "imageBrief": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "detail": {
      "type": "object", "additionalProperties": false,
      "required": ["headline", "lead", "points"],
      "properties": {
        "headline": { "type": "string", "minLength": 1, "maxLength": 20 },
        "lead": { "type": "string", "minLength": 1, "maxLength": 48 },
        "points": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["label", "text"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 8 },
              "text": { "type": "string", "minLength": 1, "maxLength": 32 }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["headline", "compareWith", "rows", "cons", "verdict"],
      "properties": {
        "headline": { "type": "string", "minLength": 1, "maxLength": 14 },
        "compareWith": { "type": "string", "minLength": 1, "maxLength": 14 },
        "rows": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["item", "prev", "next", "change"],
            "properties": {
              "item": { "type": "string", "minLength": 1, "maxLength": 5 },
              "prev": { "type": "string", "minLength": 1, "maxLength": 12 },
              "next": { "type": "string", "minLength": 1, "maxLength": 12 },
              "change": { "enum": ["up", "down", "same", "new"] }
            }
          }
        },
        "cons": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 24 } },
        "verdict": { "type": "string", "minLength": 1, "maxLength": 26 }
      }
    }
  }
}
