{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IT 카드뉴스 3p",
  "description": "글자 수는 공백 포함, [[ ]] 제외 기준. 형광펜 칸의 maxLength는 [[ ]] 기호만큼 여유를 둔 값이며 정확한 검사는 studio.html이 한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "cover", "detail", "summary"],
  "properties": {
    "meta": {
      "type": "object", "additionalProperties": false,
      "required": ["product", "status", "date", "sources"],
      "properties": {
        "product": { "type": "string", "minLength": 1, "maxLength": 14 },
        "status": { "enum": ["공식", "루머", "유출"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "url"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 20 },
              "url": { "type": "string", "pattern": "^https?://\\S+$" }
            }
          }
        }
      }
    },
    "cover": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "imageBrief"],
      "properties": {
        "title": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 11 } },
        "imageBrief": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "detail": {
      "type": "object", "additionalProperties": false,
      "required": ["headline", "paras", "conclusion"],
      "properties": {
        "headline": { "type": "string", "minLength": 1, "maxLength": 30 },
        "paras": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 34 }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["headline", "compareWith", "rows", "cons", "conclusion"],
      "properties": {
        "headline": { "type": "string", "minLength": 1, "maxLength": 30 },
        "compareWith": { "type": "string", "minLength": 1, "maxLength": 14 },
        "rows": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["item", "prev", "next"],
            "properties": {
              "item": { "type": "string", "minLength": 1, "maxLength": 5 },
              "prev": { "type": "string", "minLength": 1, "maxLength": 11 },
              "next": { "type": "string", "minLength": 1, "maxLength": 11 }
            }
          }
        },
        "cons": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 24 } },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 34 }
      }
    }
  }
}
